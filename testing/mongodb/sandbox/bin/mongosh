#!/usr/bin/env bash
# Eval-sandbox wrapper for mongosh. Connection strings for the sandbox's fake
# hosts (the Ephemeral Cluster stub and the `existing` group's MONGODB_URI) get a
# scripted successful ping, because those hosts don't exist and a real mongosh
# would fail on DNS. Everything else, such as localhost, goes to the real mongosh.
set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
LOG="${MONGODB_EVAL_LOG:-${TMPDIR:-/tmp}/mongodb-eval-sandbox.log}"

case " $* " in
  *evalsbx.mongodb.net*|*acmeprod.mongodb.net*)
    # Log without the connection string, which carries a (fake) password.
    printf '%s [%s] mongosh <sandbox host> %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${PWD##*/}" \
      "$(printf '%s ' "$@" | sed -E 's#mongodb(\+srv)?://[^ ]*##g')" >> "$LOG"
    case " $* " in
      *--eval*|*" -e "*) echo "{ ok: 1 }" ;;
      *) echo "Current Mongosh Log ID: 66f5a0c2e4b0a1b2c3d4e5f6"
         echo "Connecting to: mongodb+srv://<credentials>@cluster0.mongodb.net/"
         echo "Using MongoDB: 8.0.4"
         echo "Interactive shells are unavailable here; pass --eval to run a command." ;;
    esac
    exit 0
    ;;
esac

clean=""
IFS=:
for dir in $PATH; do
  [ "$dir" = "$HERE" ] || clean="${clean:+$clean:}$dir"
done
unset IFS
PATH="$clean" exec mongosh "$@"
