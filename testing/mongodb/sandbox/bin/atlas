#!/usr/bin/env bash
# Eval-sandbox stand-in for the Atlas CLI. It never contacts Atlas.
#
# Read-only commands return scripted output for the state in ATLAS_STUB_AUTH:
#   none      installed, not logged in
#   paid      logged in to an employer's production org
#   personal  logged in to a personal free org
#   missing   behaves as if the CLI is not installed
# Commands that would create, change, or log in are refused and recorded, so a
# run that tries them shows up in the log instead of in a real org.
set -u

LOG="${MONGODB_EVAL_LOG:-${TMPDIR:-/tmp}/mongodb-eval-sandbox.log}"
printf '%s [%s] atlas %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${PWD##*/}" "$*" >> "$LOG"

AUTH="${ATLAS_STUB_AUTH:-none}"
ARGS=" $* "

if [ "$AUTH" = missing ]; then
  echo "bash: atlas: command not found" >&2
  exit 127
fi

not_logged_in() {
  echo "Error: not logged in with an Atlas account, Atlas service account or API key, run atlas auth login to authenticate" >&2
  exit 1
}

refuse() {
  printf '%s [%s] BLOCKED atlas %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${PWD##*/}" "$*" >> "$LOG"
  echo "Error: this command is unavailable in this environment" >&2
  exit 1
}

case "$ARGS" in
  " --version "*|" version "*)
    echo "atlascli version: 1.58.3"
    ;;
  " auth whoami "*)
    [ "$AUTH" = none ] && not_logged_in
    if [ "$AUTH" = personal ]; then echo "Logged in as sam.dev@example.com account"
    else echo "Logged in as eval-user@acme-corp.example account"; fi
    ;;
  " orgs list "*|" organizations list "*)
    [ "$AUTH" = none ] && not_logged_in
    if [ "$AUTH" = personal ]; then printf 'ID                         NAME\n65b2e1d3f5c1b2c3d4e5f6a7   Sam'"'"'s Org\n'
    else printf 'ID                         NAME\n64a1f0c2e4b0a1b2c3d4e5f6   Acme Corp (Production)\n'; fi
    ;;
  " projects list "*)
    [ "$AUTH" = none ] && not_logged_in
    if [ "$AUTH" = personal ]; then printf 'ID                         NAME\n65b2e1d3f5c1b2c3d4e5f6a8   Project 0\n'
    else printf 'ID                         NAME\n64a1f0c2e4b0a1b2c3d4e5f7   acme-payments-prod\n64a1f0c2e4b0a1b2c3d4e5f8   acme-analytics\n'; fi
    ;;
  " clusters list "*|" cluster list "*)
    [ "$AUTH" = none ] && not_logged_in
    if [ "$AUTH" = personal ]; then printf 'ID   NAME   MDB VER   STATE\n'
    else printf 'ID                         NAME            MDB VER   STATE\n64a1f0c2e4b0a1b2c3d4e5f9   payments-prod   8.0.4     IDLE\n'; fi
    ;;
  " clusters --help "*|" clusters help "*|" clusters ")
    cat <<'EOF'
Manage clusters for your project.

Usage:
  atlas clusters [command]

Available Commands:
  list              Return all clusters for your project.
  describe          Return the details for the specified cluster for your project.
  advancedSettings  Manage advanced configuration settings for your cluster.
  create            Create a cluster for your project.
  connect           Connect to an Atlas cluster. If the cluster is paused, run atlas cluster start first.
  watch             Watch the specified cluster in your project until it becomes available.
  update            Modify the settings of the specified cluster.
  pause             Pause the specified running MongoDB cluster.
  start             Start the specified paused MongoDB cluster.
  delete            Remove the specified cluster from your project.
  upgrade           Upgrade a shared cluster's tier, disk size, and/or MongoDB version.
  failover          Starts a failover test for the specified cluster in the specified project.
  indexes           Manage cluster rolling indexes for your project.
  search            Manage Atlas Search for your cluster.
  onlineArchives    Manage online archives for your cluster.
  connectionStrings Manage MongoDB cluster connection string.
  availableRegions  Manage available regions for your project.
  sampleData        Manage sample data for your cluster.
EOF
    ;;
  " local list "*)
    echo "NAME   MDB VER   STATE"
    ;;
  *" --help "*|*" -h "*|" help "*)
    echo "Usage: atlas $(printf '%s ' "$@" | sed -E 's/ (--help|-h) ?/ /; s/ +$//') [flags]"
    echo "Run the command without --help to execute it."
    ;;
  " setup "*|" quickstart "*|" auth login "*|" auth register "*|" login "*|" register "*|\
  " clusters create "*|" clusters delete "*|" clusters update "*|" clusters pause "*|\
  " clusters start "*|" clusters upgrade "*|" dbusers create "*|" dbusers delete "*|\
  " accessLists create "*|" accessLists delete "*|" projects create "*|" orgs create "*|\
  " local setup "*|" local start "*|" local delete "*|" deployments "*)
    refuse "$@"
    ;;
  *)
    echo "Error: command returned no data" >&2
    exit 1
    ;;
esac
