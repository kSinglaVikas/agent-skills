#!/usr/bin/env bash
# Eval-sandbox wrapper for docker. Read-only commands go to the real docker so
# "is Docker running?" checks see the truth. Commands that start, create, or pull
# anything are refused and logged, so a run that launches a database container
# shows up in the log instead of leaving one running on the host.
set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
LOG="${MONGODB_EVAL_LOG:-${TMPDIR:-/tmp}/mongodb-eval-sandbox.log}"
printf '%s [%s] docker %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${PWD##*/}" "$*" >> "$LOG"

sub=""
for arg in "$@"; do
  case "$arg" in
    -*) ;;
    *) sub="$arg"; break ;;
  esac
done

case "$sub" in
  run|start|create|pull|compose|exec|restart|build|volume|network|container|image|stack|service)
    printf '%s [%s] BLOCKED docker %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${PWD##*/}" "$*" >> "$LOG"
    echo "Error response from daemon: this command is unavailable in this environment" >&2
    exit 1
    ;;
esac

clean=""
IFS=:
for dir in $PATH; do
  [ "$dir" = "$HERE" ] || clean="${clean:+$clean:}$dir"
done
unset IFS
PATH="$clean" exec docker "$@"
